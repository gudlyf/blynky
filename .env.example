# Copy to .env and edit. Anything already set in the real environment wins.

# Vision model
# Provider can be "ollama" (default) or "gemini".
# VISION_PROVIDER=ollama
# Minimum seconds between requests to vision provider (default 0).
# PROVIDER_PAUSE=0

# Ollama settings
OLLAMA_URL=http://localhost:11434/v1
# Under Docker, Ollama on the host is http://host.docker.internal:11434/v1
OLLAMA_MODEL=minimax-m3:cloud

# Gemini settings (if using Google Gemini)
# Required for using Gemini as the vision provider.
# GEMINI_API_KEY=your-gemini-api-key
# Optional/Advanced overrides with default values
# Provides good descriptions and has highest rate limits for free tier.
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_URL=https://generativelanguage.googleapis.com/v1beta/openai
# Overrides PROVIDER_PAUSE if set (e.g. 4.5s avoids free-tier 15 RPM rate limits).
# GEMINI_PAUSE=4.5


MAX_FRAMES=4
MAX_TOKENS=1500
VISION_TIMEOUT=180
# Retries, with exponential backoff from this many seconds, when the provider
# answers 429 (rate limited) or 503 (busy).
VISION_MAX_RETRIES=4
VISION_RETRY_DELAY=5.0

# Web server
HOST=127.0.0.1
PORT=8080

# Blink polling
POLL_SECONDS=60
CATCH_UP=0
# Call each camera "System:Camera", for an account with several Blink systems
# where two cameras can share a name. Only needed when two do: names already
# unique just get longer.
# Turning it on renames every camera. Everything captured before stays filed
# under the old name, so on an archive that already has captures, the library's
# camera list shows each camera twice - old name and new - and daily summaries
# split the same way, until the old captures are refiled with
# scripts/rename_camera.py "Old Name" "System:Old Name" --data ./data --apply
# (app stopped). Turning it off again is the same rename in reverse. Best
# decided before the first capture. See "Two cameras with the same name" in
# docs/guide.md.
# SYSTEM_PREFIX=1
HISTORY=50

# Library view
PAGE_SIZE=60

# Rows in the motion timeline under the grid, and in each camera's own
TIMELINE=25

# Describing
# Describe saved clips that have no description at start-up (0 to disable).
BACKFILL=1
# Seconds between clips while working through that backlog.
BACKFILL_PAUSE=2
# Give up on a clip after this many failed attempts.
DESCRIBE_ATTEMPTS=3

# Daily summaries - one short account of each camera's day, from the day's
# descriptions. Off until switched on here or in the settings menu, which wins
# once used. Each day is one request to the model per summary.
# DAILY_SUMMARIES=1
# What gets one: any of camera, location (each Blink system) and all (every
# camera together), comma separated.
# DAILY_SCOPES=camera
# Also push each night's summaries to ntfy, one per summary, at low priority.
# NTFY_DAILY=1
# Their ntfy priority: low, so they arrive without a sound in the night.
# NTFY_DAILY_PRIORITY=2
# Hour, server time, after which yesterday is summarized.
# DAILY_HOUR=1
# Most clip descriptions one summary is written from; a busier day is sampled.
# DAILY_MAX_CLIPS=300
# Seconds between days while backfilling summaries.
# DAILY_PAUSE=2
# Days run midnight to midnight in this time zone. A container is on UTC
# unless this is set.
# TZ=America/New_York

# Notifications - empty means nothing is ever sent.
# NTFY_URL=https://ntfy.sh/your-topic-here
# Send each Blink system's notifications to its own topic, <system>-<topic>
# (https://ntfy.sh/cabin-your-topic-here). On whenever SYSTEM_PREFIX is.
# NTFY_SYSTEM_TOPICS=1
# Which subjects are worth waking a phone for: person, animal, vehicle, package.
NTFY_SUBJECTS=person
# 1 min, 3 default, 5 max.
NTFY_PRIORITY=4
# Seconds one camera must wait before it may notify again.
NTFY_COOLDOWN=120
# Seconds before giving up on reaching the ntfy server.
NTFY_TIMEOUT=15
# Where your phone reaches this server. Set, tapping a notification opens the
# capture in Blynky. Use a LAN, VPN or tailnet address, never one open to the
# internet: Blynky has no login, and this address is sent in every notification.
# BLYNKY_URL=https://blynky.your-tailnet.ts.net

# Known people - guess who a person is, once any have been enrolled in the UI.
IDENTIFY=1
# Least confidence that counts as a match: low, medium or high. Strict on
# purpose - a wrong match quietly downgrades the alert about a stranger.
IDENTIFY_MIN_CONFIDENCE=high
# Reference frames kept per person, and the total sent in one identification.
MAX_REFERENCES=5
IDENTIFY_MAX_IMAGES=12
# Seconds before giving up on an identification, which sends more images
# than a description and so gets a longer limit than VISION_TIMEOUT.
IDENTIFY_TIMEOUT=240
# Priority for someone recognised, versus NTFY_PRIORITY for anyone else.
NTFY_KNOWN_PRIORITY=2
# Say nothing at all when everyone seen is recognised.
NTFY_SKIP_KNOWN=0

# Sync now button - how many recent clips per camera it pulls, and how far
# back it asks the cloud feed. The sync module's own storage is read whole.
SYNC_LIMIT=5
SYNC_DAYS=2

# Camera renames made before data/cameras.json existed, as Old Name=New Name
# pairs separated by commas. Later renames are picked up on their own.
CAMERA_RENAMES=

# Retention - 0 keeps everything, which is the default.
RETAIN_DAYS=0
# Log what would be deleted and delete nothing. Run once before trusting it.
RETAIN_DRY_RUN=0

# Docker only - where compose publishes the port on the host. The app itself
# always listens on 0.0.0.0:8080 inside the container, and HOST/PORT above are
# ignored there.
# BIND_ADDR=127.0.0.1
# HOST_PORT=8080

# Paths
# CREDFILE=.blink_creds.json
# DATA_DIR=data
